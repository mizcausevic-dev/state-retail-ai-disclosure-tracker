{"event_id":"02-il-0001","state":"US-IL","timestamp":"2008-10-03T10:00:00Z","lifecycle_state":"effective","effective_date":"2008-10-03","regulatory_vehicle":"state-biometric-statute","citation":{"short_label":"BIPA 740 ILCS 14","long_title":"Illinois Biometric Information Privacy Act","jurisdictional_uri":"https://www.ilga.gov/legislation/ilcs/ilcs3.asp?ActID=3004","session_year":2008},"scope":{"covered_decisions":["biometric-identification","biometric-age-verification","loyalty-tier-classification"],"covered_actors":["online-retailer","brick-and-mortar-retailer","omnichannel-retailer","biometric-vendor","loyalty-platform-vendor","ai-vendor"]},"obligation_kinds":["biometric-written-consent-required","biometric-retention-schedule-required","biometric-no-profit-sharing-required","ai-system-inventory-required"],"regulator":{"primary_agency_code":"IL-AG","primary_agency_name":"Illinois Attorney General","primary_agency_uri":"https://www.illinoisattorneygeneral.gov/"},"notes":"Private right of action with statutory damages of $1,000 per negligent violation and $5,000 per intentional / reckless violation. The strongest state biometric law and the most frequently litigated."}
{"event_id":"02-il-0002","state":"US-IL","timestamp":"2024-08-02T10:00:00Z","lifecycle_state":"amended","effective_date":"2024-08-02","supersedes_event_id":"02-il-0001","regulatory_vehicle":"state-biometric-statute","citation":{"short_label":"BIPA 740 ILCS 14 (2024 amendment, SB 2979)","long_title":"BIPA Amendment limiting per-scan accrual","jurisdictional_uri":"https://www.ilga.gov/legislation/billstatus.asp?DocNum=2979&GAID=17","session_year":2024},"scope":{"covered_decisions":["biometric-identification","biometric-age-verification","loyalty-tier-classification"],"covered_actors":["online-retailer","brick-and-mortar-retailer","omnichannel-retailer","biometric-vendor","loyalty-platform-vendor","ai-vendor"]},"obligation_kinds":["biometric-written-consent-required","biometric-retention-schedule-required","biometric-no-profit-sharing-required","ai-system-inventory-required"],"regulator":{"primary_agency_code":"IL-AG","primary_agency_name":"Illinois Attorney General","primary_agency_uri":"https://www.illinoisattorneygeneral.gov/"},"notes":"SB 2979 (Aug 2024) limits violations to one per person per kind of biometric data + one collection / disclosure, capping the per-scan stacking risk that drove $228M White Castle and similar verdicts."}
